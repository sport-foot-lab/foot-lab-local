# Copier ce fichier en « .env » et mettre tes vraies valeurs.
# Le .env reste sur ton PC : il ne se partage pas et ne va pas dans Git.
PGADMIN_EMAIL=ton_email@exemple.com
PGADMIN_PASSWORD=ton_mot_de_passe


# Clé API-Football (à demander / à récupérer sur api-football.com)
API_FOOTBALL_KEY=ta_cle_ici
# Base de prod Postgres vue depuis le PC (valeurs locales de test du compose)
PG_PROD_URL=postgresql://airflow:airflow@localhost:8181/datalab